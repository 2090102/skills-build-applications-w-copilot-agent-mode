# OctoFit Tracker Frontend Environment Variables (Example)
# 
# Copy this file to .env.local and update the values
# 
# For GitHub Codespaces:
# 1. Find your Codespace name from the URL or settings
# 2. Set VITE_CODESPACE_NAME to your exact Codespace name
# 3. This generates API URLs like:
#    https://scaling-broccoli-xyz123-8000.app.github.dev/api
#
# For Local Development (localhost):
# Leave VITE_CODESPACE_NAME empty or unset
# API will use: http://localhost:8000/api

VITE_CODESPACE_NAME=
